# Local Postgres for the HTS tables (createdb hts && set the URL below).
HTS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hts"

# Required to run the agent and the optional embeddings step.
OPENAI_API_KEY=""

# Model id for the agent. Swappable — see README "Accuracy expectations".
HTS_MODEL="gpt-5-mini"

# OpenAI Responses API reasoning effort: minimal | low | medium | high
HTS_REASONING_EFFORT="medium"

# Optional: Langfuse Cloud tracing (traces/generations/spans + eval scores).
# Get keys from your project's Settings > API Keys at https://cloud.langfuse.com.
# Left blank, the agent runs exactly as before with zero tracing.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# EU cloud (default) or US cloud: "https://us.cloud.langfuse.com"
LANGFUSE_BASEURL="https://cloud.langfuse.com"
